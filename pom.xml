<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.hsh</groupId>
    <artifactId>permcheck</artifactId>
    <version>0.0.1</version>
    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <build>
        <resources> 
            <resource>
                <!-- for debugging purposes: -->
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.java</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <!-- Global configuration: Applies as a baseline to ALL execution phases (compile AND testCompile) -->
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
					<!-- Using -source/-target instead of <release>17</release>, otherwise 
					     add-exports argument below is rejected by javac -->
					<source>17</source>
					<target>17</target>
                </configuration>
				<executions>
					<!-- 
						WHY ARE <executions> NEEDED HERE?
						
						The maven-compiler-plugin does not provide a dedicated parameter like <testCompilerArgs>.
						To pass compiler flags (such as add-exports) EXCLUSIVELY when compiling test classes,
						without polluting the main build step (src/main), you must override the plugin's default 
						test execution phase.

						By targeting the built-in execution ID 'default-testCompile', Maven intercepts the standard
						lifecycle phase and applies/merges this specific <configuration> during 'testCompile'.

						References & Documentation:
						- Configuring Plugin Executions & Standard IDs:
						  https://maven.apache.org/guides/mini/guide-configuring-plugins.html#Using_the_executions_Tag
						- Plugin Goal Reference (testCompile):
						  https://maven.apache.org/plugins/maven-compiler-plugin/testCompile-mojo.html
						- Maven Default Lifecycle Bindings ('default-testCompile'):
						  https://maven.apache.org/ref/current/maven-core/default-bindings.html
					-->
					<execution>
						<!-- Exact ID of Maven's built-in execution step for test compilation -->
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
                            <compilerArgs>
								<!-- Flag added ONLY to the test-compile step -->
								
							    <!-- this switch is needed for testing main.TestMain#testReflectionAccessClassInNonExportedBootLayerPackage -->
								<arg>--add-exports</arg>
                                <arg>jdk.management.agent/sun.management.jmxremote=de.hsh.permcheck</arg>
							</compilerArgs>
						</configuration>
					</execution>
				</executions>				
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.0.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.17.7</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
        	<groupId>net.bytebuddy</groupId>
        	<artifactId>byte-buddy-agent</artifactId>
        	<version>1.17.7</version>
        </dependency>
        <dependency>
        	<groupId>junit</groupId>
        	<artifactId>junit</artifactId>
        	<version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>